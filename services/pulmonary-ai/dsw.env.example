# Alibaba DSW deployment configuration. Copy to services/pulmonary-ai/.env, then edit paths.
# Keep the service loopback-only unless an authenticated internal gateway requires a different bind address.
PULMONARY_AI_BIND_HOST=127.0.0.1
PULMONARY_AI_PORT=8020
PULMONARY_AI_DATA_DIR=/mnt/workspace/pulmonary-ai-data
# Generate this locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Do not commit or print the chosen value in logs.
PULMONARY_AI_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_VALUE

# Safe default: /health works, but job submission returns an explicit 503 and no GPU inference starts.
PULMONARY_AI_ENABLE_INFERENCE=0

# Set inference to 1 with this kept at 0 to validate only the open five-lobe task.
# The separately licensed lung_nodules task remains disabled unless this is 1.
PULMONARY_AI_RUN_NODULES=0

# These acknowledgements are required by deploy_dsw.py before inference can be enabled.
# Set each to yes only after recording the applicable task/weight licence and de-identified-sample validation.
PULMONARY_AI_LUNG_NODULES_LICENSE_REVIEWED=no
PULMONARY_AI_LUNG_NODULES_VALIDATION_RECORDED=no
